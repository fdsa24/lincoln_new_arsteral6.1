# 패키지(npm install로 다시 설치됨)
node_modules/

# Next.js 빌드 결과물(npm run build / npm run dev 때 자동 생성)
.next/
out/
build/

# 비밀 정보: API 키·DB 주소가 들어가는 파일은 절대 올리지 않음
.env
.env*.local
.env.*
!.env.example

# Vercel 로컬 설정
.vercel

# TypeScript 캐시
*.tsbuildinfo

# 테스트 결과
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# 로그·운영체제 잡파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
