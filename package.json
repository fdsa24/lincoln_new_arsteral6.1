{
  "name": "lincoln-history-lab",
  "version": "5.0.0-starter",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/core.test.ts tests/memory.test.ts tests/provider.test.ts tests/guard.test.ts",
    "test:db": "node --env-file-if-exists=.env.local --import tsx --test tests/postgres.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup": "node scripts/setup.mjs",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx scripts/db-setup.ts",
    "db:cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/db-cleanup.ts"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "pg": "8.16.3",
    "zod": "3.25.76",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/pg": "8.15.5",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "tsx": "4.21.0",
    "@playwright/test": "1.56.1",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18"
  },
  "type": "module"
}
