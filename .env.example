# 기본값은 실제 Gemini API와 PostgreSQL이 필요 없는 연습 모드입니다.
APP_MODE=demo

# 개발 중에는 비워 두면 localhost 또는 Codespaces 주소를 사용합니다.
# npm start 등 운영 실행에서는 demo 모드도 실제 서비스 주소를 지정하세요.
# 운영 live 모드에서는 HTTPS 주소가 필요합니다.
APP_ORIGIN=

# live 모드에서만 입력합니다. 비밀값이 담긴 .env.local은 Git에 올리지 마세요.
GEMINI_API_KEY=
# 기존 코드의 기본 모델명입니다. 실제 계정의 모델 지원 여부는 별도 확인하세요.
GEMINI_MODEL=gemini-3.5-flash
DATABASE_URL=

# 비워 두세요. npm run setup이 .env.local에 48자리 임의 코드를 생성합니다.
CLASSROOM_CODE=

# 전체 일일 / 사용자별 일일 / 사용자별 분당 호출 제한
GLOBAL_DAILY_TURN_LIMIT=100
OWNER_DAILY_TURN_LIMIT=30
OWNER_MINUTE_TURN_LIMIT=6
