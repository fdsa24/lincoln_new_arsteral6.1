# 연습 모드(demo) 또는 실제 AI 모드(live)
APP_MODE=demo

# 배포 환경에서는 실제 접속 도메인(예: https://your-app.vercel.app)을 입력하세요.
# 로컬 개발 및 GitHub Codespaces에서는 비워두면 자동으로 감지합니다.
APP_ORIGIN=

# 수업 입장 코드 (npm run setup 실행 시 48자리 난수로 자동 채워집니다)
CLASSROOM_CODE=

# Live 모드 설정 (APP_MODE=live 일 때 필수)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DATABASE_URL=

# DB 통합 테스트 전용 (_test 로 끝나는 테스트 DB만 허용)
TEST_DATABASE_URL=

# 사용량 제한 (선택)
GLOBAL_DAILY_TURN_LIMIT=100
OWNER_DAILY_TURN_LIMIT=30
OWNER_MINUTE_TURN_LIMIT=6
